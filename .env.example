# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (Kysely/pg). *_FILE variants take precedence when present (Docker/K8s secrets).
# Local dev may point at localhost; production MUST keep Postgres on the private network (TRD F1).
DATABASE_URL=postgres://suropark:changeme@localhost:5432/suropark_db
DATABASE_URL_FILE=

# JWT signing (EdDSA / Ed25519, TRD §16.2). PEM keys generated by npm run seed / ops tooling.
# In production supply via secrets manager, never commit.
JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_FILE=
JWT_PUBLIC_KEY=
JWT_PUBLIC_KEY_FILE=
JWT_ISSUER=suropark
JWT_AUDIENCE=suropark-api
JWT_KEY_ID=suropark-2026-01

# Optional future payment integration (MVP uses a local mock)
DOKU_BASE_URL=https://api.doku.com
DOKU_CLIENT_ID=
DOKU_CLIENT_SECRET=
DOKU_WEBHOOK_SECRET=
DOKU_PRIVATE_KEY_FILE=
DOKU_MERCHANT_ID=
DOKU_TERMINAL_ID=
DOKU_POSTAL_CODE=60111
